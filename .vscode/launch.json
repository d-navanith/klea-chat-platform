{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Klea: Debug Server",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Klea: Launch Web in Browser",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/client"
    }
  ],
  "compounds": [
    {
      "name": "Klea: Run All (Server & Client)",
      "configurations": ["Klea: Debug Server", "Klea: Launch Web in Browser"],
      "preLaunchTask": "Start Klea Client"
    }
  ]
}
