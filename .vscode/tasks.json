{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Klea Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Klea backend running.*"
        }
      }
    },
    {
      "label": "Start Klea Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": "Local:.*"
        }
      }
    },
    {
      "label": "Run Both (Server + Client)",
      "dependsOn": [
        "Start Klea Server",
        "Start Klea Client"
      ],
      "problemMatcher": []
    }
  ]
}
